# Firebase Web App config
# Copia este archivo como .env y reemplaza los valores por tu configuracion real.
# No subas .env al repositorio.

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Optional local E2E config
# Usa una cuenta exclusiva de testing, no tu cuenta principal.
E2E_AUTH_ENABLED=false
E2E_EMAIL=
E2E_PASSWORD=
E2E_REGISTER_ENABLED=false
E2E_REGISTER_PASSWORD=NexoFinTest123!
E2E_REGISTER_DOMAIN=example.com
