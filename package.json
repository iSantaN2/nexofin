{
  "name": "finapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build --configLoader runner",
    "lint": "eslint .",
    "preview": "vite preview",
    "quality": "npm run lint && npm run test && npm run build",
    "test": "vitest run --config vitest.config.js --configLoader runner",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.config.js --configLoader runner src/firestore.rules.test.js\"",
    "test:watch": "vitest --config vitest.config.js --configLoader runner",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "deploy:firestore:rules": "firebase deploy --only firestore:rules",
    "deploy:firestore:indexes": "firebase deploy --only firestore:indexes",
    "deploy:firestore": "firebase deploy --only firestore",
    "deploy:storage:rules": "firebase deploy --only storage",
    "deploy:profile-infra": "firebase deploy --only firestore:rules,storage"
  },
  "dependencies": {
    "dayjs": "^1.11.19",
    "firebase": "^12.4.0",
    "framer-motion": "^12.23.24",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "react": "^19.1.1",
    "react-calendar": "^6.0.0",
    "react-dom": "^19.1.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.3.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "firebase-tools": "^15.22.0",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
